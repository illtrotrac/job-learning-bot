# Anthropic (Claude Haiku for cheap extractions)
ANTHROPIC_API_KEY=your_anthropic_key_here

# SerpAPI (free tier: 100 searches/month) - for job scraping
SERPAPI_KEY=your_serpapi_key_here

# Tavily (free tier: 1000 searches/month) - for learning resources
TAVILY_API_KEY=your_tavily_key_here

# Telegram Bot (free) - get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Database path (relative to project root)
DB_PATH=data/job_learning.db
